<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="aruco_target_plate" params="parent_link">
    
    <joint name="aruco_pole_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="aruco_pole_link"/>
      <origin xyz="-0.22 0 0.15" rpy="0 0 0"/>
    </joint>

    <link name="aruco_pole_link">
      <visual>
        <geometry><cylinder radius="0.01" length="0.15"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <xacro:inertial_box mass="0.01" x="0.02" y="0.02" z="0.15">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <joint name="aruco_plate_joint" type="fixed">
      <parent link="aruco_pole_link"/>
      <child link="aruco_plate_link"/>
      <origin xyz="-0.01 0 0.05" rpy="0 0 3.14159"/>
    </joint>

    <link name="aruco_plate_link">
      <visual>
        <geometry><box size="0.005 0.30 0.30"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.005 0.30 0.30"/></geometry>
      </collision>
      <xacro:inertial_box mass="0.02" x="0.005" y="0.30" z="0.30">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_box>
    </link>

    <joint name="aruco_white_border_joint" type="fixed">
      <parent link="aruco_plate_link"/>
      <child link="aruco_white_border_link"/>
      <origin xyz="0.003 0 0" rpy="0 0 0"/>
    </joint>

    <link name="aruco_white_border_link">
      <visual>
        <geometry><box size="0.002 0.26 0.26"/></geometry>
        <material name="white"><color rgba="1 1 1 1"/></material>
      </visual>
    </link>

    <joint name="aruco_inner_pattern_joint" type="fixed">
      <parent link="aruco_white_border_link"/>
      <child link="aruco_inner_pattern_link"/>
      <origin xyz="0.002 0 0" rpy="0 0 0"/>
    </joint>

    <link name="aruco_inner_pattern_link">
      <visual>
        <geometry><box size="0.002 0.18 0.18"/></geometry>
        <material name="black"><color rgba="0 0 0 1"/></material>
      </visual>
    </link>

    <joint name="aruco_center_dot_joint" type="fixed">
      <parent link="aruco_inner_pattern_link"/>
      <child link="aruco_center_dot_link"/>
      <origin xyz="0.002 0 0" rpy="0 0 0"/>
    </joint>

    <link name="aruco_center_dot_link">
      <visual>
        <geometry><box size="0.002 0.08 0.08"/></geometry>
        <material name="white"><color rgba="1 1 1 1"/></material>
      </visual>
    </link>

    <gazebo reference="aruco_plate_link">
      <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
    </gazebo>
    <gazebo reference="aruco_white_border_link">
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
    </gazebo>
    <gazebo reference="aruco_inner_pattern_link">
      <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
    </gazebo>
    <gazebo reference="aruco_center_dot_link">
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
    </gazebo>

  </xacro:macro>

</robot>