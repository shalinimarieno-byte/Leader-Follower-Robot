<?xml version="1.0"?>
<robot name="follower_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find leader_follower_bot)/urdf/inertia_macros.xacro" />
  <xacro:include filename="$(find leader_follower_bot)/urdf/camera.xacro" />

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="0.48 0.32 0.15"/></geometry>
      <!-- CHANGED: Dark Grey / Metallic Body Color -->
      <material name="dark_grey"><color rgba="0.2 0.2 0.25 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="0.48 0.32 0.15"/></geometry>
    </collision>
    <xacro:inertial_box mass="3.5" x="0.48" y="0.32" z="0.15">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- Accent Trim Plate on top for visual contrast -->
  <joint name="accent_plate_joint" type="fixed">
    <parent link="base_link"/>
    <child link="accent_plate"/>
    <origin xyz="0 0 0.076" rpy="0 0 0"/>
  </joint>
  <link name="accent_plate">
    <visual>
      <geometry><box size="0.46 0.30 0.005"/></geometry>
      <material name="accent_orange"><color rgba="1.0 0.4 0.0 1.0"/></material>
    </visual>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.16 0.21 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="front_left_wheel">
    <visual><geometry><cylinder radius="0.09" length="0.04"/></geometry><material name="black"><color rgba="0 0 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.09" length="0.04"/></geometry></collision>
    <xacro:inertial_cylinder mass="0.4" length="0.04" radius="0.09"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_cylinder>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.16 -0.21 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="front_right_wheel">
    <visual><geometry><cylinder radius="0.09" length="0.04"/></geometry><material name="black"><color rgba="0 0 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.09" length="0.04"/></geometry></collision>
    <xacro:inertial_cylinder mass="0.4" length="0.04" radius="0.09"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_cylinder>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.16 0.21 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rear_left_wheel">
    <visual><geometry><cylinder radius="0.09" length="0.04"/></geometry><material name="black"><color rgba="0 0 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.09" length="0.04"/></geometry></collision>
    <xacro:inertial_cylinder mass="0.4" length="0.04" radius="0.09"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_cylinder>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.16 -0.21 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rear_right_wheel">
    <visual><geometry><cylinder radius="0.09" length="0.04"/></geometry><material name="black"><color rgba="0 0 0 1"/></material></visual>
    <collision><geometry><cylinder radius="0.09" length="0.04"/></geometry></collision>
    <xacro:inertial_cylinder mass="0.4" length="0.04" radius="0.09"><origin xyz="0 0 0" rpy="0 0 0"/></xacro:inertial_cylinder>
  </link>

  <!-- Gazebo Material Overrides -->
  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="accent_plate">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="front_left_wheel"><mu1>0.8</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="front_right_wheel"><mu1>0.8</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>0.8</mu1><mu2>0.3</mu2></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>0.8</mu1><mu2>0.3</mu2></gazebo>

  <xacro:camera_sensor parent_link="base_link" />

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.42</wheel_separation>
      <wheel_radius>0.09</wheel_radius>
      <topic>/follower/cmd_vel</topic>
      <odom_topic>/follower/odom</odom_topic>
      <tf_topic>/follower/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

</robot>